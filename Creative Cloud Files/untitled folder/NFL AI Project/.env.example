# ── LLM / Chatbot ────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to: anthropic | openai | local
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model names (defaults used if omitted)
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/db/nfl.db

# ── Betting Data ──────────────────────────────────────────────────────────────
# Free tier available at https://the-odds-api.com
THE_ODDS_API_KEY=your_odds_api_key_here

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ── Scraping ──────────────────────────────────────────────────────────────────
SCRAPE_RATE_LIMIT_SECONDS=3
SCRAPE_USER_AGENT=NFL-AI-Research-Bot/1.0 (educational project)

# ── Data ──────────────────────────────────────────────────────────────────────
NFL_SEASONS=2020,2021,2022,2023,2024

# ── Model Paths ───────────────────────────────────────────────────────────────
MODEL_DIR=models
WIN_MODEL_PATH=models/win_predictor.joblib
ATS_MODEL_PATH=models/ats_predictor.joblib
